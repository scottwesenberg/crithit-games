{
  "name": "crithit-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:import-real": "tsx scripts/import-real-catalog.ts",
    "db:set-admin-password": "tsx scripts/set-admin-password.ts",
    "db:remove-demo": "tsx scripts/remove-demo-data.ts",
    "db:snapshot": "docker compose exec -T db pg_dump -U crithit -d crithit --data-only --disable-triggers --no-owner --no-privileges > prisma/catalog-snapshot.sql && node scripts/strip-snapshot.mjs",
    "db:restore": "docker compose exec -T db psql -U crithit -d crithit -v ON_ERROR_STOP=1 < prisma/catalog-snapshot.sql"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.19.1",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.5.0",
    "papaparse": "5.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "16.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.15",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "5.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.32",
    "prisma": "5.19.1",
    "tailwindcss": "3.4.10",
    "tsx": "^4.23.15",
    "typescript": "5.5.4"
  },
  "allowScripts": {
    "@prisma/client@5.19.1": true,
    "@prisma/engines@5.19.1": true,
    "prisma": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
