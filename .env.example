# --- Database (Postgres) ---
# Local dev with the included docker-compose.yml:
DATABASE_URL="postgresql://crithit:crithit@localhost:5432/crithit?schema=public"

# --- App ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
APP_URL="http://localhost:3000"

# --- Stripe ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="your-stripe-secret-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"
# From `stripe listen --print-secret` locally, or the webhook's signing secret in the Dashboard
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# --- Outbound email (registration verification, password reset, order emails) ---
# Any standard SMTP provider works: Postmark, SES, Mailgun, SendGrid SMTP, Gmail app password, etc.
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey-or-username"
EMAIL_SERVER_PASSWORD="password-or-api-key"
EMAIL_FROM="CritHit Games <orders@crithitgames.com>"

# --- Seed / bootstrap admin ---
SEED_ADMIN_EMAIL="admin@crithitgames.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
