# --- Database (Postgres) ---
# Local dev with the included docker-compose.yml:
DATABASE_URL="postgresql://crithit:crithit@localhost:5432/crithit?schema=public"

# --- App ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
APP_URL="http://localhost:3000"

# --- Stripe ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="your-stripe-secret-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"
# From `stripe listen --print-secret` locally, or the webhook's signing secret in the Dashboard
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# --- Outbound email (registration verification, password reset, order emails) ---
# Any standard SMTP provider works: Brevo (free tier), Postmark, SES, Mailgun, etc.
# Brevo: host smtp-relay.brevo.com, port 587, user = your SMTP login, password = an SMTP key, and EMAIL_FROM must be
# a sender you've verified in Brevo. Leave these unset to run in demo mode (no emails, accounts auto-verified).
EMAIL_SERVER_HOST="smtp-relay.brevo.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-brevo-smtp-login"
EMAIL_SERVER_PASSWORD="your-brevo-smtp-key"
EMAIL_FROM="CritHit Games <your-verified-sender@example.com>"

# --- Two-factor authentication ---
# Optional. Key used to encrypt authenticator (TOTP) secrets in the database. If unset, NEXTAUTH_SECRET is used.
# Set it to a long random value if you want to rotate NEXTAUTH_SECRET independently. Changing either one later
# invalidates enrolled authenticator apps (users would need to re-enroll or use recovery codes).
TOTP_ENCRYPTION_KEY=""

# --- Seed / bootstrap admin ---
SEED_ADMIN_EMAIL="admin@crithitgames.com"
# Required: choose your own unique password (12+ characters). Never reuse a value from docs or examples.
SEED_ADMIN_PASSWORD=""
